<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_pembayaran" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <parameter name="P_TANGGAL_AWAL" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-11-01")]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TANGGAL_AKHIR" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-11-30")]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[SELECT
    pb.id_pembayaran,
    pb.tanggal_bayar,
    pb.nominal,
    pb.metode,
    pb.status AS status_pembayaran,
    p.id_pendaftaran,
    ps.nim,
    ps.nama AS nama_peserta,
    kls.nama_kelas,
    krs.nama_kursus
FROM pembayaran pb
INNER JOIN pendaftaran p
    ON pb.id_pendaftaran = p.id_pendaftaran
INNER JOIN peserta ps
    ON p.id_peserta = ps.id_peserta
INNER JOIN kelas kls
    ON p.id_kelas = kls.id_kelas
INNER JOIN kursus krs
    ON kls.id_kursus = krs.id_kursus
WHERE pb.tanggal_bayar BETWEEN $P{P_TANGGAL_AWAL}
    AND $P{P_TANGGAL_AKHIR}
ORDER BY pb.tanggal_bayar, pb.id_pembayaran]]>
    </queryString>

    <field name="id_pembayaran" class="java.lang.Integer"/>
    <field name="tanggal_bayar" class="java.sql.Date"/>
    <field name="nominal" class="java.math.BigDecimal"/>
    <field name="metode" class="java.lang.String"/>
    <field name="status_pembayaran" class="java.lang.String"/>
    <field name="id_pendaftaran" class="java.lang.Integer"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_peserta" class="java.lang.String"/>
    <field name="nama_kelas" class="java.lang.String"/>
    <field name="nama_kursus" class="java.lang.String"/>

    <variable name="TOTAL_NOMINAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{nominal}]]></variableExpression>
    </variable>

    <title>
        <band height="72">
            <staticText>
                <reportElement x="0" y="4" width="535" height="30"/>
                
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN PEMBAYARAN KURSUS]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="34" width="535" height="18"/>
                
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <text><![CDATA[SIKURSUS Desktop - Pemrograman Berorientasi Objek]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="52" width="535" height="16"/>
                
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Periode: " + new java.text.SimpleDateFormat("dd-MM-yyyy").format($P{P_TANGGAL_AWAL}) + " s/d " + new java.text.SimpleDateFormat("dd-MM-yyyy").format($P{P_TANGGAL_AKHIR})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="0" y="0" width="30" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="30" y="0" width="58" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Tanggal]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="88" y="0" width="58" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[NIM]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="146" y="0" width="95" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Peserta]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="241" y="0" width="50" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Kelas]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="291" y="0" width="90" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Kursus]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="381" y="0" width="65" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Nominal]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="446" y="0" width="45" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Metode]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="491" y="0" width="44" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="30" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id_pembayaran}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="30" y="0" width="58" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal_bayar})]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="88" y="0" width="58" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="146" y="0" width="95" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="241" y="0" width="50" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="291" y="0" width="90" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="381" y="0" width="65" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("#,##0").format($F{nominal})]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="446" y="0" width="45" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{metode}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="491" y="0" width="44" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status_pembayaran}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="4" width="267" height="16"/>
                
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Dicetak: " + new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="268" y="4" width="267" height="16"/>
                
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="30">
            <staticText>
                <reportElement x="0" y="6" width="420" height="20"/>
                
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL PEMBAYARAN (semua status)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement mode="Opaque" backcolor="#FFF8DC" x="425" y="6" width="110" height="20"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + new java.text.DecimalFormat("#,##0").format($V{TOTAL_NOMINAL})]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>

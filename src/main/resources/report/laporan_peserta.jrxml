<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_peserta" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <queryString>
        <![CDATA[SELECT
    id_peserta,
    nim,
    nama,
    jenis_kelamin,
    prodi,
    no_hp,
    email
FROM peserta
ORDER BY nama ASC]]>
    </queryString>

    <field name="id_peserta" class="java.lang.Integer"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama" class="java.lang.String"/>
    <field name="jenis_kelamin" class="java.lang.String"/>
    <field name="prodi" class="java.lang.String"/>
    <field name="no_hp" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>

    <title>
        <band height="64">
            <staticText>
                <reportElement x="0" y="4" width="535" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA PESERTA KURSUS]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="34" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <text><![CDATA[SIKURSUS Desktop - Pemrograman Berorientasi Objek]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="0" y="0" width="30" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="30" y="0" width="70" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[NIM]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="100" y="0" width="120" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Nama]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="220" y="0" width="30" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[JK]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="250" y="0" width="100" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Prodi]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="350" y="0" width="85" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[No. HP]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#F7CF5F" x="435" y="0" width="100" height="24"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#7A5C00"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Email]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="30" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="30" y="0" width="70" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="0" width="120" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="220" y="0" width="30" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{jenis_kelamin}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="0" width="100" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{prodi}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="350" y="0" width="85" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{no_hp}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="435" y="0" width="100" height="22"/>
                <box padding="3"><pen lineWidth="0.5" lineColor="#999999"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <textField>
                <reportElement x="0" y="4" width="267" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Dicetak: " + new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="268" y="4" width="267" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
